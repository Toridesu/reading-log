# 設定項目の見本。scripts/setup-local.sh が実際の.envとランダムなパスワードを生成します。
APP_ADDR=127.0.0.1:8080
DB_PORT=5432
# 管理者はDB初期化用、アプリは専用ユーザーのパスワードを使う。
POSTGRES_PASSWORD=replace-with-local-admin-password
APP_DB_PASSWORD=replace-with-local-app-password
# Goからの接続先。通常用とテスト用でDBを分ける。
DATABASE_URL=postgres://readinglog:replace-with-local-app-password@127.0.0.1:5432/readinglog?sslmode=disable
TEST_DATABASE_URL=postgres://readinglog:replace-with-local-app-password@127.0.0.1:5432/readinglog_test?sslmode=disable

# ブラウザーとGoが同じissuerを使う。localhostと127.0.0.1を混ぜない。
APP_BASE_URL=http://localhost:8080
KEYCLOAK_PORT=8081
OIDC_ISSUER=http://localhost:8081/realms/reading-log
OIDC_CLIENT_ID=reading-log
OIDC_CLIENT_SECRET=replace-with-local-client-secret
KEYCLOAK_ADMIN_PASSWORD=replace-with-local-admin-password
# aliceとbobのローカル検証用パスワード。実際の値はsetup-local.shで生成する。
LOCAL_USER_PASSWORD=replace-with-local-user-password
